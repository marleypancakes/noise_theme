<section class="section-cta relative py-16 sm:py-24 lg:py-[6em]">
    <div class="px-8 lg:px-[4em] flex flex-col gap-6 lg:gap-[0.5em]">
        <div class="w-full flex gap-8 increase-height">
            <div class="h-0 min-w-[11px] bg-[--accent-color] relative before:absolute before:top-0 before:left-0 before:w-full before:h-full before:blur-[--blur-lg] before:bg-[--accent-color] transition-[height] duration-1000 delay-100"></div>
            <h1 class="cta-title text-[1.75rem] leading-9 md:text-[1.875rem] md:leading-[2.375rem] lg:text-[2.5em] lg:leading-[1.25em] text-[--heading-color] font-bold font-primary fade-in transition-all duration-1000 delay-100">
                {{title}}
            </h1>
        </div>
        <div class="w-full flex flex-col md:flex-row items-center justify-between gap-6">
            <p class="cta-description fade-in lg:max-w-50">
                {{description}}
            </p>
            <div class="cta-button fade-in transition-all duration-1000 delay-100 flex justify-end w-full md:w-auto">
                <a href="{{#if button_link}}{{button_link}}{{else}}#{{/if}}" class="relative block uppercase font-medium text-center text-sm lg:text-[0.9em] lg:leading-loose leading-8 text-[--cta-color] hover:text-[--cta-color-hover] bg-[--cta-bg] hover:bg-[--cta-bg-hover] px-4 py-2 border border-[--border-color] transition-all duration-100 before:absolute before:top-0 before:left-0 before:w-full before:h-full before:bg-[--cta-bg] before:blur-[--blur-lg] before:-z-10 w-full sm:w-auto">
                    {{button}}
                </a>
            </div>
        </div>
    </div>
    {{^is "post"}}
    <div class="luminous-borders-container">
        <div class="luminous-borders-blur border-b-2"></div>
        <div class="luminous-borders-solid border-b-2"></div>
    </div>
    {{/is}}
</section>