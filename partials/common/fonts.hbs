{{!-- Load font styles based on Ghost Admin settings. You can read the documentation to add more fonts --}}
{{!-- Primary Font --}}
{{#if @custom.primary_font}}
    {{!-- CUSTOM FONTS ADDED BY MARLEY--}}
    {{!-- JAF Lapture --}}
    {{#match @custom.primary_font "JAF Lapture"}}
    <link rel="preload" href="{{asset 'fonts/JAF-LaptureDisplay-Web-Regular-full.woff2'}}" as="font" type="font/woff2">
    <style>
        @font-face {
            font-family: 'JAF Lapture';
            src: url('{{asset "fonts/JAF-LaptureDisplay-Web-Regular-full.woff2"}}') format('woff2');
            font-weight: normal;
            font-style: normal;
            font-display: swap;
        }
        @font-face {
            font-family: 'JAF Lapture';
            src: url('{{asset "fonts/JAF-LaptureDisplay-Web-Bold-full.woff2"}}') format('woff2');
            font-weight: bold;
            font-style: normal;
            font-display: swap;
        }
        @font-face {
            font-family: 'JAF Lapture';
            src: url('{{asset "fonts/JAF-LaptureDisplay-Web-RegularItalic-full.woff2"}}') format('woff2');
            font-weight: normal;
            font-style: italic;
            font-display: swap;
        }
        @font-face {
            font-family: 'JAF Lapture';
            src: url('{{asset "fonts/JAF-LaptureDisplay-Web-BoldItalic-full.woff2"}}') format('woff2');
            font-weight: bold;
            font-style: italic;
            font-display: swap;
        }
        body {
            --font-primary: 'JAF Lapture';
        }
    </style>
    {{/match}}

