{{!< default}}
{{#page}}
    {{> common/page-hero}}
    <section class="section-tags-page js-content-section relative px-4 sm:px-8 lg:px-[4em] pb-16 sm:pb-36 lg:pb-[9em] pt-20 lg:pt-[6.5em]">
        <div class="js-content-wrap lg:max-w-[70em] mx-auto transition-all duration-1000 delay-100 fade-in">
            {{content}}
        </div>
        <div class="luminous-borders-container">
            <div class="luminous-borders-blur border-b-2"></div>
            <div class="luminous-borders-solid border-b-2"></div>
        </div>
    </section>
    <section class="section-tags-page-list-container relative">
        <div class="grid grid-cols-1 lg:grid-cols-4">
            {{#get "tags" limit="all" include="count.posts" order="count.posts desc"}}
                {{#foreach tags}}
                    {{> tag/tag-card}}
                {{/foreach}}
            {{/get}}
        </div>
        <div class="luminous-borders-container">
            <div class="luminous-borders-blur border-b-2"></div>
            <div class="luminous-borders-solid border-b-2"></div>
        </div>
    </section>
{{/page}}