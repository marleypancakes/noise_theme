{{!< default}}
<section class="section-error-page relative">
    <div class="relative">
        <div class="py-20 lg:py-[6.5em] px-4 sm:px-8 flex items-center justify-center">
            <div class="max-w-[800px] lg:max-w-[50em] flex flex-col items-center justify-center gap-4 lg:gap-[1.3em]">
                <div class="section-error-page-message overflow-hidden slide-container">
                    <div class="translate-y-full hover:translate-y-0 transition-all duration-1000 delay-100">
                        <div class="uppercase text-[--heading-color] text-sm lg:text-[1em] leading-loose"> {{message}} </div>
                    </div>
                </div>
                <h1 class="section-error-page-status font-bold font-primary text-[--heading-color] text-center text-[2rem] md:text-[36px] lg:text-[3em] leading-[2.5rem] md:leading-[44px] lg:leading-[4em] transition-all duration-1000 delay-100 fade-in"> {{statusCode}} </h1>
                <div class="section-error-page-button w-full mt-8 lg:mt-[2em] flex flex-col sm:flex-row justify-start items-center gap-y-8 gap-x-12 md:gap-x-10 lg:gap-x-[3em] transition-all duration-1000 delay-100">
                    <a href="{{@site.url}}" class="block w-full md:w-[18em] relative py-[9px] sm:py-2 lg:py-[0.5em] px-[14px] sm:px-4 lg:px-[1em] uppercase text-center text-[--cta-color] bg-[--cta-bg] font-medium text-sm sm:text-[0.9rem] lg:text-[0.9em] leading-8 before:absolute before:top-0 before:left-0 before:w-full before:h-full before:bg-[--cta-bg] before:blur-[--blur-lg] before:-z-10 hover:bg-[--cta-bg-hover] hover:text-[--cta-color-hover] transition-all duration-200 border border-[--border-color]" target="_blank" rel="noreferrer noopener"> {{t "Back to Home"}} </a>
                </div>
            </div>
        </div>
        <div class="noise-bg"></div>
        <div class="white-bg"></div>
        <div class="luminous-borders-container">
            <div class="luminous-borders-blur border-b-2"></div>
            <div class="luminous-borders-solid border-b-2"></div>
        </div>
    </div>
</section>