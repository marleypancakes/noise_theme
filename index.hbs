{{!< default}}
{{!-- First section on the homepage. Section includes featured image, Site title, Site description along with a button.
Title, description, button label and button URL can be configured from Ghost settings --}}
{{> home/hero}}
{{!-- This partial will show a horizontally moving images of all brand logos.
To change/add any brand logo, please create light and dark version of the brand logo and add them in /assets/images/brand-logos.
Ensure you are keeping the file name same and should match 'brand (x).png' format, where 'x' is any number from 1 to 21 --}}
{{#if @custom.show_brand_logos }}
    {{> home/brand-logos}}
{{/if}}
{{#if posts}}
    {{!-- Title for 'Featured Articles' --}}
    {{> common/title title="Featured Articles" h1=false}}
    {{#get "posts" limit="3" include="tags,authors" filter="featured:true"}}
        <div class="grid grid-cols-1 xl:grid-cols-3">
            {{#foreach posts}}
                {{> post-card isFeaturedSection="true"}}
            {{/foreach}}
        </div>
    {{/get}}
    {{!-- This partial will show the Welcome message with a title. Both the title and description is configurable from the Ghost settings --}}
    {{> home/welcome}}
    {{!-- Title for 'Articles' --}}
    {{> common/title title="Articles" h1=false}}
    {{!-- List of top tags --}}
    {{> tag/tag-list}}
    {{!-- Blog card loop --}}
    {{> loop}}
    {{!-- Pagination for the above loop --}}
    {{#if @custom.show_pagination}}
        {{pagination}}
    {{else}}
        <div class="relative">
            <div class="py-20 lg:py-[6.5em] px-4 sm:px-8 flex items-center justify-center">
                <div class="max-w-[800px] lg:max-w-[50em] flex flex-col items-center justify-center gap-4 lg:gap-[1.3em]">
                    <div class="overflow-hidden slide-container">
                        <div class="hover:translate-y-0 transition-all duration-1000 delay-100">
                            <div class="text-[--heading-color] text-sm lg:text-[1em] leading-loose"> {{t "Click the button below to see all articles"}} </div>
                        </div>
                    </div>
                    {{!-- Load more posts button --}}
                    <a href="/articles" class="relative block uppercase font-medium text-center text-sm lg:text-[0.9em] lg:leading-loose leading-8 text-[--cta-color] hover:text-[--cta-color-hover] bg-[--cta-bg] hover:bg-[--cta-bg-hover] px-4 py-2 border border-[--border-color] transition-all duration-100 before:absolute before:top-0 before:left-0 before:w-full before:h-full before:bg-[--cta-bg] before:blur-[--blur-lg] before:-z-10 w-full sm:w-auto">
                        {{t "All Articles"}}
                    </a>
                </div>
            </div>
            <div class="noise-bg"></div>
            <div class="white-bg"></div>
            <div class="luminous-borders-container">
                <div class="luminous-borders-blur border-b-2"></div>
                <div class="luminous-borders-solid border-b-2"></div>
            </div>
        </div>
    {{/if}}
{{/if}}
{{!-- List of top 4 authors --}}
{{> author/authors}}
{{!-- List of top 4 tags --}}
{{> tag/tags}}
{{!-- Homepage CTA section --}}
{{> common/cta
    title=(t "CTA_TITLE")
    description=(t "CTA_DESCRIPTION")
    button=(t "CTA_BUTTON_LABEL")
    button_link=(t "CTA_LINK")
}}